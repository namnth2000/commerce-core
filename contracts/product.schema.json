{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-core.local/contracts/product.schema.json",
  "title": "commerce-core Product v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "name",
    "description",
    "price",
    "images",
    "active"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "integer",
      "minimum": 0,
      "description": "Whole amount in the store currency. For VND this is whole dong."
    },
    "compareAtPrice": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean"
    }
  }
}
