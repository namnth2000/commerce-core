{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-core.local/contracts/store.schema.json",
  "title": "commerce-core Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "currency", "locale", "contact", "checkout"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tagline": { "type": "string", "maxLength": 240 },
    "currency": { "const": "VND" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone"],
      "properties": {
        "phone": { "type": "string", "minLength": 1, "maxLength": 30 },
        "email": { "type": ["string", "null"], "maxLength": 254 },
        "address": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facebook": { "type": ["string", "null"] },
        "tiktok": { "type": ["string", "null"] }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentMethods", "shippingMethods"],
      "properties": {
        "paymentMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cod", "bank_transfer", "payos"] }
        },
        "shippingMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "fee"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "fee": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "bankTransfer": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["bankName", "accountName", "accountNumber"],
          "properties": {
            "bankName": { "type": "string", "minLength": 1, "maxLength": 100 },
            "accountName": { "type": "string", "minLength": 1, "maxLength": 100 },
            "accountNumber": { "type": "string", "minLength": 1, "maxLength": 50 },
            "transferNotePrefix": { "type": "string", "maxLength": 20 }
          }
        }
      }
    }
  }
}
