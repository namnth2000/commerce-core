{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-core.local/contracts/store.schema.json",
  "title": "commerce-core Store v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "currency",
    "locale",
    "contact",
    "checkout"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone"],
      "properties": {
        "phone": { "type": "string", "minLength": 1 },
        "email": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facebook": { "type": ["string", "null"] },
        "tiktok": { "type": ["string", "null"] }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentMethods", "shippingMethods"],
      "properties": {
        "paymentMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["cod", "bank_transfer", "payos"]
          }
        },
        "shippingMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "fee"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "fee": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
